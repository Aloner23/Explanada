rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/plz_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/plz_users/$(request.auth.uid)).data.active == true;
    }
    function role() { return get(/databases/$(database)/documents/plz_users/$(request.auth.uid)).data.role; }
    function manager() { return active() && role() in ['OWNER', 'ADMIN']; }
    function parking() { return active() && role() in ['OWNER', 'ADMIN', 'PARKING_STAFF']; }
    function employee() { return active() && role() in ['OWNER', 'ADMIN', 'PARKING_STAFF', 'STAFF']; }
    function ownTenant(id) { return active() && role() == 'TENANT' && get(/databases/$(database)/documents/plz_users/$(request.auth.uid)).data.tenantId == id; }
    match /plz_users/{id} {
      allow get: if (active() && request.auth.uid == id) || employee();
      allow list: if employee();
      // All profile, role, password and activation changes go through accountApi.
      allow write: if false;
    }
    match /plz_config/{id} {
      allow get: if id == 'global';
      allow list: if active();
      allow write: if manager();
    }
    match /plz_gallery/{id} { allow read: if true; allow write: if manager(); }
    match /plz_tenants/{id} {
      allow read: if manager() || ownTenant(id);
      allow create, update: if manager() && !request.resource.data.keys().hasAny(['systemPassword']);
      allow delete: if manager();
    }
    match /plz_tickets/{id} {
      allow read: if parking();
      allow create: if parking() && request.resource.data.id == id && request.resource.data.status == 'active';
      allow update: if parking() && request.resource.data.id == id && request.resource.data.entryTime == resource.data.entryTime;
      allow delete: if manager();
    }
    match /plz_transactions/{id} {
      allow read: if parking() || ownTenant(resource.data.tenantId);
      allow create: if manager() || (parking() && request.resource.data.type in ['PARKING', 'VISIT', 'AUDIT']);
      allow update: if manager() || (parking() && resource.data.type in ['PARKING', 'VISIT', 'AUDIT'] && request.resource.data.type == resource.data.type);
      allow delete: if manager();
    }
    match /plz_frequent_customers/{id} { allow read, write: if parking(); }
    match /plz_tasks/{id} { allow read, write: if employee(); }
    match /{table}/{id} {
      allow read, write: if manager() && table in ['plz_reservations', 'plz_ad_spaces', 'plz_staff', 'plz_attendance', 'plz_payroll', 'plz_accounts', 'plz_policies', 'plz_cost_centers', 'plz_account_balances', 'plz_accounting_config'];
    }
    // Rate limits, unknown collections and nested paths are denied by default.
  }
}
