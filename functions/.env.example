# Cloud Functions — copia a functions/.env (ignorado por Git).

# URL base del puente POS/ERP que implementa el contrato genérico (docs/POS.md):
#   POST /sales  ·  GET /sales/:ref  ·  GET /health. Debe ser HTTPS.
POS_API_URL=https://pos.example.com/api

# Excepción HTTP explícita (solo si el POS no soporta TLS): ambas variables deben
# coincidir EXACTAMENTE con POS_API_URL para que el proxy acepte http://.
POS_ALLOW_HTTP=false
POS_HTTP_EXCEPTION_URL=

# Orígenes adicionales permitidos por CORS (separados por coma).
ALLOWED_ORIGINS=

# GEMINI_API_KEY NO se define aquí: se declara como secreto de la función
#   firebase functions:secrets:set GEMINI_API_KEY
