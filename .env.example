# ───────────────────────────────────────────────────────────────
# Cliente (Vite). Copia a `.env.local` y ajusta. NUNCA subas secretos.
# Sin este archivo la app usa el proyecto ficticio `demo-plaza`.
# ───────────────────────────────────────────────────────────────

# Configuración web de Firebase (es pública por diseño; la seguridad la dan las reglas)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-plaza
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = conectar a Firebase Emulators (lo activa `npm run demo` automáticamente)
VITE_USE_EMULATORS=false
VITE_EMULATOR_HOST=127.0.0.1

# Origen de Hosting que usa el cliente de escritorio (Electron carga desde file://)
# Ej. https://<tu-proyecto>.web.app
VITE_API_BASE_URL=

# EmailJS (opcional). Vacío = modo simulación, no se envían correos.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_ADMIN_EMAIL=admin@example.com
VITE_REPLY_TO_EMAIL=no-reply@example.com

# ───────────────────────────────────────────────────────────────
# NO van aquí: la clave de Gemini (GEMINI_API_KEY) vive en Secret Manager
# y la configuración del POS en functions/.env (ver functions/.env.example).
# ───────────────────────────────────────────────────────────────
